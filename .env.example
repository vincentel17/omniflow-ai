# ==============================
# OmniFlow AI Environment Config
# ==============================
#
# Service grouping:
# - shared: variables used by multiple services
# - web: Next.js / preview shell
# - api: FastAPI / migrations / health endpoints
# - worker: Celery worker and demo simulator tick
#
# Deployment guidance:
# - staging: APP_ENV=staging, CONNECTOR_MODE=mock, AI_MODE=mock
# - production: APP_ENV=production, CONNECTOR_MODE=mock, AI_MODE=mock
# - production additionally requires APP_ENCRYPTION_KEY

# ---- SHARED RUNTIME ----
NODE_ENV=development
PYTHON_ENV=development
APP_NAME=omniflow-ai
APP_ENV=development
LOG_LEVEL=info

# ---- SHARED DATA STORES ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=omniflow
POSTGRES_USER=omniflow
POSTGRES_PASSWORD=omniflow
DATABASE_URL=postgresql+psycopg://omniflow:omniflow@localhost:5432/omniflow
VECTOR_DIMENSION=1536

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- WEB (apps/web) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_BASE_URL=http://api:8000
NEXT_PUBLIC_AI_MODE=mock
NEXT_PUBLIC_CONNECTOR_MODE=mock
NEXT_PUBLIC_DEMO_SIMULATOR=false
NEXT_PUBLIC_PREVIEW_ORG=beta
NEXT_PUBLIC_PREVIEW_ROLE=owner
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ---- API (apps/api) ----
API_HOST=0.0.0.0
API_PORT=8000
FASTAPI_ENV=development
SECRET_KEY_BASE=
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEV_AUTH_BYPASS=false
DEV_USER_ID=11111111-1111-1111-1111-111111111111
DEV_ORG_ID=22222222-2222-2222-2222-222222222222
DEV_ROLE=owner
AUTH_MODE=hybrid
AUTH_COOKIE_NAME=omniflow_session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=28800
CORS_ALLOWED_ORIGINS=http://localhost:13000,http://localhost:3000
TOKEN_ENCRYPTION_KEY=

# ---- WORKER / DEMO OPS (apps/worker + cron) ----
ALLOW_QA_SEED=false
ALLOW_QA_RESET=false
DEMO_SIMULATOR=false
DEMO_SIM_SEED=1234

# ---- CONNECTORS ----
CONNECTOR_MODE=mock
OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback
ALLOWED_OAUTH_REDIRECT_URIS=http://localhost:3000/api/auth/callback
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PROVIDER_ENABLE_GBP=false
# ---- AI PROVIDER ----
AI_MODE=mock
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com
OPENAI_API_VERSION=v1

# ---- AUTH PLACEHOLDERS ----
CLERK_SECRET_KEY=
CLERK_JWT_KEY=

# ---- OBSERVABILITY ----
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ---- FEATURE FLAGS ----
FEATURE_ADS_AUTOMATION=false
FEATURE_REAL_ESTATE_PACK=true
FEATURE_HOME_CARE_PACK=false

# ---- ORG OPS DEFAULTS (DB-backed after first run) ----
# enable_auto_posting=false
# enable_auto_reply=false
# enable_auto_lead_routing=true
# enable_auto_nurture_apply=false
